{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "FS Launcher",
  "version": "0.1.1",
  "identifier": "ru.lambda.fslauncher",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "FS Launcher | 0.1.1 stable",
        "width": 1024,
        "height": 576,
        "decorations": false,
        "shadow": false,
        "resizable": false,
        "transparent": true,
        "devtools": false,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },  
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/icon.ico"
    ]
  }
}
